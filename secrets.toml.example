# Copie este contenido en Streamlit Cloud > App settings > Secrets (NO suba el archivo real a GitHub)

# 1) Clave para habilitar registro/edición/carga (opcional; si se omite, cualquiera puede editar)
[edicion]
password = "CambiarEstaClave"

# 2) Respaldo automático de la matriz en su repositorio GitHub (opcional pero recomendado)
[github]
token  = "github_pat_xxxxxxxxxxxxxxxx"   # token fine-grained con permiso Contents: Read and write
repo   = "usuario/kpi-entrega-informes"
branch = "main"
path   = "data/matriz_kpi_informes.xlsx"
